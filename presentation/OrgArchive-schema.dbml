Project OrgArchive {
  database_type: 'MariaDB'
  Note: 'Organization is a logical tenant key. The schema has no organization table or foreign keys between these three tables.'
}

Table app_user {
  username varchar(64) [pk]
  display_name varchar(128) [not null]
  email varchar(128) [not null]
  password_hash varchar(80) [not null]
  role varchar(32) [not null]
  organization varchar(64) [not null]
}

Table note {
  id bigint [pk, increment]
  organization varchar(64) [not null]
  title varchar(255) [not null]
  body text [not null]
}

Table document {
  id bigint [pk, increment]
  title varchar(255) [not null]
  content text [not null]
  metadata text [not null, note: 'JSON with organization, category and revision']
}
