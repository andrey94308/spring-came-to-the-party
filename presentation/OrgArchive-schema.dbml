Project OrgArchive {
  database_type: 'MariaDB'
  Note: 'organization_uuid is a logical tenant identifier. There is no organization table or foreign key to document metadata.'
}

Table app_user {
  username varchar(64) [pk]
  display_name varchar(128) [not null]
  email varchar(128) [not null]
  password_hash varchar(80) [not null]
  role varchar(32) [not null]
  organization_uuid varchar(36) [not null]
}

Table document {
  id bigint [pk, increment]
  title varchar(255) [not null]
  content text [not null]
  metadata text [not null, note: 'JSON with organizationUuid, category and revision']
}
