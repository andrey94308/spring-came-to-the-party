Project OrgArchive {
  database_type: 'MariaDB'
  Note: 'organization_uuid identifies the tenant on both users and documents. There is no separate organization table.'
}

Table app_user {
  username varchar(64) [pk]
  display_name varchar(128) [not null]
  email varchar(128) [not null]
  password_hash varchar(80) [not null]
  role varchar(32) [not null]
  organization_uuid varchar(36) [not null]
}

Table document {
  id bigint [pk, increment]
  title varchar(255) [not null]
  content text [not null]
  organization_uuid varchar(36) [not null]
  metadata text [not null, note: 'JSON with category and revision']

  Indexes {
    organization_uuid [name: 'idx_document_organization']
  }
}
